[Unit]
Description=Hermes local Prometheus for Netdata host metrics
Wants=network-online.target
After=network-online.target netdata.service

[Service]
Type=simple
User=prometheus
Group=prometheus
ExecStart=/usr/bin/prometheus --config.file=/etc/hermes-netdata-metrics/prometheus.yml --storage.tsdb.path=/var/lib/hermes-netdata-metrics/prometheus --storage.tsdb.retention.time=7d --storage.tsdb.retention.size=1GB --web.listen-address=127.0.0.1:9090 --web.max-connections=32
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hermes-netdata-metrics/prometheus
MemoryMax=512M
CPUQuota=50%
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
