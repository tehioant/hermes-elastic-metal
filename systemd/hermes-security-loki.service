[Unit]
Description=Hermes local security log store (Loki)
After=network.target

[Service]
Type=simple
User=loki-security
Group=loki-security
ExecStart=/usr/local/bin/hermes-security-loki -config.file=/etc/hermes-security-dashboard/loki.yaml -target=all
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hermes-security-dashboard/loki
MemoryMax=1536M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
