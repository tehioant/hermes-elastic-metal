          "expr": "count(sum by (src_ip) (count_over_time({job=\"security-watch\"} | json | kind=\"attempt\" | src_ip=~`${source_ip:raw}` | protocol=~\"${protocol:regex}\" | label_format src_ip=\"{{.src_ip}}\" [$__range])))",
          "queryType": "instant"
        }
