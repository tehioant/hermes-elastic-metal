    {
      "id": 6,
      "type": "geomap",
      "title": "Approximate source geolocation (emitted flows)",
      "datasource": {
        "type": "loki",
        "uid": "local-loki"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (latitude, longitude) (count_over_time({job=\"security-watch\"} | json | kind=\"attempt\" | src_ip=~`${source_ip:raw}` | protocol=~\"${protocol:regex}\" | latitude!=\"\" | longitude!=\"\" | label_format latitude=\"{{.latitude}}\", longitude=\"{{.longitude}}\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "view": {
          "id": "zero",
          "lat": 0,
          "lon": 0,
          "zoom": 1
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": true
        },
        "basemap": {
          "type": "default",
          "name": "OSM Standard",
          "config": {}
        },
        "layers": [
          {
            "type": "markers",
            "name": "Approximate source locations",
            "config": {
              "showLegend": true,
              "style": {
                "size": {
                  "fixed": 5,
                  "field": "Value"
                },
                "color": {
                  "fixed": "blue",
                  "field": "Value"
                },
                "symbol": {
                  "fixed": "circle",
                  "field": "Value"
                },
                "opacity": 0.8
              }
            },
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            }
          }
        ]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns",
            "valueLabel": "Value"
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "latitude",
                "destinationType": "number"
              },
              {
                "targetField": "longitude",
                "destinationType": "number"
              }
            ]
          }
        }
      ]
    },
    {
