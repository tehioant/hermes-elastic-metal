<ossec_config>
  <global>
    <jsonout_output>yes</jsonout_output><alerts_log>yes</alerts_log>
    <logall>no</logall><logall_json>no</logall_json><email_notification>no</email_notification>
  </global>
  <alerts><log_alert_level>3</log_alert_level></alerts>
  <remote>
    <connection>secure</connection><local_ip>127.0.0.1</local_ip>
    <port>1514</port><protocol>tcp</protocol><queue_size>131072</queue_size>
  </remote>
  <auth><disabled>yes</disabled></auth>
  <cluster><disabled>yes</disabled></cluster>
  <active-response><disabled>yes</disabled></active-response>
  <rootcheck><disabled>yes</disabled></rootcheck>
  <syscheck><disabled>yes</disabled></syscheck>
  <sca><enabled>no</enabled></sca>
  <wodle name="syscollector"><disabled>yes</disabled></wodle>
  <vulnerability-detection>
    <enabled>yes</enabled><index-status>yes</index-status><feed-update-interval>60m</feed-update-interval>
  </vulnerability-detection>
  <indexer>
    <enabled>yes</enabled><hosts><host>https://127.0.0.1:9200</host></hosts>
    <ssl><certificate_authorities><ca>/etc/ssl/root-ca.pem</ca></certificate_authorities>
    <certificate>/etc/ssl/filebeat.pem</certificate><key>/etc/ssl/filebeat.key</key></ssl>
  </indexer>
  <ruleset>
    <decoder_dir>ruleset/decoders</decoder_dir><rule_dir>ruleset/rules</rule_dir>
    <rule_exclude>0215-policy_rules.xml</rule_exclude>
    <list>etc/lists/audit-keys</list><list>etc/lists/amazon/aws-eventnames</list>
    <list>etc/lists/security-eventchannel</list>
    <list>etc/lists/malicious-ioc/malicious-ip</list>
    <list>etc/lists/malicious-ioc/malicious-domains</list>
    <list>etc/lists/malicious-ioc/malware-hashes</list>
    <decoder_dir>etc/decoders</decoder_dir><rule_dir>etc/rules</rule_dir>
  </ruleset>
  <rule_test><enabled>yes</enabled><threads>1</threads><max_sessions>16</max_sessions><session_timeout>15m</session_timeout></rule_test>
</ossec_config>
