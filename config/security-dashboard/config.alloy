// This collector is intentionally selective: no whole-system journal or app logs.
// Labels are only the fixed job name and host; IPs and paths remain log fields.
loki.write "local" {
  endpoint {
    url = "http://127.0.0.1:3100/loki/api/v1/push"
  }
}

loki.source.journal "ufw" {
  matches    = "_TRANSPORT=kernel SYSLOG_IDENTIFIER=kernel"
  labels     = { job = "ufw", host = constants.hostname }
  forward_to = [loki.process.ufw.receiver]
}

loki.process "ufw" {
  stage.label_drop {
    values = ["filename", "service_name", "detected_level"]
  }
  stage.match {
    selector = "{job=\"ufw\"} !~ \".*UFW (BLOCK|REJECT).*\""
    action   = "drop"
  }
  forward_to = [loki.write.local.receiver]
}

loki.source.journal "ssh" {
  matches    = "_COMM=sshd"
  labels     = { job = "ssh", host = constants.hostname }
  forward_to = [loki.process.ssh.receiver]
}

// Current OpenSSH uses a separate session process; readers do not overlap.
loki.source.journal "ssh_session" {
  matches    = "_COMM=sshd-session"
  labels     = { job = "ssh", host = constants.hostname }
  forward_to = [loki.process.ssh.receiver]
}

loki.process "ssh" {
  stage.label_drop {
    values = ["filename", "service_name", "detected_level"]
  }
  forward_to = [loki.write.local.receiver]
}

loki.source.file "fail2ban" {
  targets = [{ __path__ = "/var/log/fail2ban.log", job = "fail2ban", host = constants.hostname }]
  forward_to = [loki.process.fail2ban.receiver]
}

loki.process "fail2ban" {
  stage.label_drop {
    values = ["filename", "service_name", "detected_level"]
  }
  forward_to = [loki.write.local.receiver]
}

// Re-emit an allowlist of Caddy metadata; never store raw JSON request headers.
loki.source.journal "caddy" {
  matches    = "_SYSTEMD_UNIT=caddy.service"
  labels     = { job = "caddy", host = constants.hostname }
  forward_to = [loki.process.caddy.receiver]
}

loki.process "caddy" {
  stage.label_drop {
    values = ["filename", "service_name", "detected_level"]
  }
  stage.json {
    drop_malformed = true
    expressions = {
      logger    = "logger",
      status    = "status",
      remote_ip = "request.remote_ip",
      method    = "request.method",
      host      = "request.host",
      uri       = "request.uri",
      user_id   = "user_id",
    }
  }
  // Transient label for selection only; remove it before writing to Loki.
  stage.labels {
    values = { access_logger = "logger" }
  }
  stage.match {
    selector = "{job=\"caddy\",access_logger!~\"http[.]log[.]access([.].+)?\"}"
    action   = "drop"
  }
  stage.label_drop {
    values = ["access_logger"]
  }
  stage.regex {
    source     = "uri"
    expression = "^(?P<path>[^?]*)"
  }
  stage.template {
    source   = "safe_message"
    template = "status={{.status}} remote_ip={{.remote_ip}} method={{.method}} host={{.host}} path={{.path}} user_id={{.user_id}}"
  }
  stage.output {
    source = "safe_message"
  }
  forward_to = [loki.write.local.receiver]
}

// Server Watch journal reader: only the dedicated collector unit is consumed.
loki.source.journal "security_watch" {
  matches    = "_SYSTEMD_UNIT=hermes-security-watch.service"
  labels     = { job = "security-watch", host = constants.hostname }
  forward_to = [loki.process.security_watch.receiver]
}

loki.process "security_watch" {
  stage.label_drop {
    values = ["filename", "service_name", "detected_level"]
  }
  stage.json {
    drop_malformed = true
    expressions = {
      schema                = "schema",
      kind                  = "kind",
      ts                    = "ts",
      interface             = "interface",
      src_ip                = "src_ip",
      dst_ip                = "dst_ip",
      src_port              = "src_port",
      dst_port              = "dst_port",
      protocol              = "protocol",
      attempt_type          = "attempt_type",
      ip_version            = "ip_version",
      ttl                   = "ttl",
      decision              = "decision",
      geo_status            = "geo_status",
      country               = "country",
      country_code          = "country_code",
      city                  = "city",
      latitude              = "latitude",
      longitude             = "longitude",
      asn                   = "asn",
      as_org                = "as_org",
      packets_received      = "packets_received",
      packets_dropped       = "packets_dropped",
      events_emitted        = "events_emitted",
      events_limited        = "events_limited",
      packets_deduplicated  = "packets_deduplicated",
      parse_errors          = "parse_errors",
      cache_evictions       = "cache_evictions",
      geo_db_month          = "geo_db_month",
      started_ts            = "started_ts",
    }
  }
  stage.labels {
    values = { watch_kind = "kind", watch_schema = "schema" }
  }
  // Reject unsupported schema versions and all kinds except attempt/health.
  stage.match {
    selector = "{job=\"security-watch\",watch_kind!~\"attempt|health\"}"
    action   = "drop"
  }
  stage.match {
    selector = "{job=\"security-watch\",watch_schema!=\"1\"}"
    action   = "drop"
  }
  stage.label_drop {
    values = ["watch_kind", "watch_schema"]
  }
  // Rebuild the output from canonical keys only; safe JSON encoding prevents
  // quotes or control characters in metadata from escaping the log record.
  stage.template {
    source = "safe_event"
    template = "{{ pick (fromJson .Entry) \"schema\" \"kind\" \"ts\" \"interface\" \"src_ip\" \"dst_ip\" \"src_port\" \"dst_port\" \"protocol\" \"attempt_type\" \"ip_version\" \"ttl\" \"decision\" \"geo_status\" \"country\" \"country_code\" \"city\" \"latitude\" \"longitude\" \"asn\" \"as_org\" \"packets_received\" \"packets_dropped\" \"events_emitted\" \"events_limited\" \"packets_deduplicated\" \"parse_errors\" \"frames_unclassified\" \"tcp_ack_seen\" \"cache_evictions\" \"coverage\" \"geo_db_month\" \"started_ts\" | toJson }}"
  }
  stage.output {
    source = "safe_event"
  }
  stage.label_keep {
    values = ["job", "host"]
  }
  stage.label_drop {
    values = ["service_name", "detected_level", "filename", "watch_kind", "watch_schema"]
  }
  forward_to = [loki.write.local.receiver]
}
