# Copy to .env, fill in, then: source .env
# Read by both the scw CLI and the Terraform scaleway provider.
export SCW_ACCESS_KEY="SCW..."
export SCW_SECRET_KEY="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
export SCW_DEFAULT_PROJECT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
export SCW_DEFAULT_ORGANIZATION_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
export SCW_DEFAULT_ZONE="fr-par-2"
export SCW_DEFAULT_REGION="fr-par"
