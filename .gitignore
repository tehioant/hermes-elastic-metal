# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Plan output
*.tfplan
tfplan

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data,
# such as password, private keys, and other secrets.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Ignore override files as they are usually used to override resources
# locally and so are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Secrets / local env
.env
.env.*
!.env.example
.envrc
!.envrc.example
*.pem
*.key
restic.env
restic-password
.restic-password

# Python test caches
__pycache__/

# macOS / editors
.DS_Store
.idea/
.vscode/
*.swp
